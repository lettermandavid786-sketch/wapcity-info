<div class="os5"/><p>&#1047;&#1072;&#1083; &#1089;&#1083;&#1072;&#1074;&#1099;</p>
<p>
  &#1050;&#1088;&#1086;&#1081;&#1092;.<br/> &#1054;&#1073;&#1097;&#1072;&#1077;&#1090;&#1089;&#1103; &#1085;&#1072; &#1092;&#1086;&#1088;&#1091;&#1084;&#1077; &#1073;&#1086;&#1083;&#1100;&#1096;&#1077; &#1075;&#1086;&#1076;&#1072;. &#1063;&#1077;&#1083;&#1086;&#1074;&#1077;&#1082; &#1086;&#1073;&#1097;&#1080;&#1090;&#1077;&#1083;&#1100;&#1085;&#1099;&#1081;, &#1093;&#1072;&#1088;&#1072;&#1082;&#1090;&#1077;&#1088; &#1091;&#1087;&#1088;&#1103;&#1084;&#1099;&#1081;, &#1085;&#1086; &#1089; &#1086;&#1090;&#1084;&#1077;&#1085;&#1085;&#1099;&#1084; &#1095;&#1091;&#1074;&#1089;&#1090;&#1074;&#1086;&#1084; &#1102;&#1084;&#1086;&#1088;&#1072;, &#1080; &#1073;&#1099;&#1089;&#1090;&#1088;&#1099;&#1084; &#1086;&#1088;&#1080;&#1077;&#1085;&#1090;&#1080;&#1088;&#1086;&#1074;&#1072;&#1085;&#1080;&#1077;&#1084; &#1074; &#1088;&#1072;&#1079;&#1083;&#1080;&#1095;&#1085;&#1099;&#1093; &#1089;&#1080;&#1090;&#1091;&#1072;&#1094;&#1080;&#1103;&#1093;, &#1101;&#1090;&#1086; &#1093;&#1086;&#1088;&#1086;&#1096;&#1086; &#1089;&#1086;&#1095;&#1080;&#1090;&#1072;&#1077;&#1090;&#1089;&#1103;. &#1048;&#1084;&#1077;&#1077;&#1090; &#1084;&#1085;&#1086;&#1075;&#1086; &#1076;&#1088;&#1091;&#1079;&#1077;&#1081;. (&#1077;&#1089;&#1090;&#1077;&#1089;&#1090;&#1074;&#1077;&#1085;&#1085;&#1086; &#1080; &#1085;&#1077;&#1076;&#1088;&#1091;&#1075;&#1086;&#1074;) &#1061;&#1086;&#1088;&#1086;&#1096;&#1080;&#1081; &#1076;&#1088;&#1091;&#1075;, &#1075;&#1086;&#1090;&#1086;&#1074;&#1099;&#1081; &#1074;&#1089;&#1077;&#1075;&#1076;&#1072; &#1087;&#1088;&#1080;&#1081;&#1090;&#1080; &#1085;&#1072; &#1087;&#1086;&#1084;&#1086;&#1097;&#1100;.<br/><br/>&#1056;&#1077;&#1084;&#1072;&#1088;&#1082;.<br/>&#1044;&#1086;&#1083;&#1075;&#1086;&#1078;&#1080;&#1090;&#1077;&#1083;&#1100; &#1085;&#1072;&#1096;&#1077;&#1075;&#1086; &#1092;&#1086;&#1088;&#1091;&#1084;&#1072;. &#1061;&#1072;&#1088;&#1072;&#1082;&#1090;&#1077;&#1088; &#1089;&#1083;&#1086;&#1078;&#1085;&#1099;&#1081;. &#1053;&#1086; &#1101;&#1090;&#1086; &#1085;&#1072; &#1087;&#1077;&#1088;&#1074;&#1099;&#1081; &#1074;&#1079;&#1075;&#1083;&#1103;&#1076;. &#1042; &#1084;&#1077;&#1088;&#1091; &#1089;&#1091;&#1088;&#1086;&#1074;, &#1074; &#1084;&#1077;&#1088;&#1091; &#1076;&#1086;&#1073;&#1088;.&#1059;&#1084;&#1077;&#1077;&#1090; &#1087;&#1088;&#1080;&#1085;&#1080;&#1084;&#1072;&#1090;&#1100; &#1073;&#1099;&#1089;&#1090;&#1088;&#1099;&#1077;, &#1085;&#1077;&#1086;&#1078;&#1080;&#1076;&#1072;&#1085;&#1085;&#1099;&#1077;, &#1087;&#1088;&#1072;&#1074;&#1080;&#1083;&#1100;&#1085;&#1099;&#1077; &#1088;&#1077;&#1096;&#1077;&#1085;&#1080;&#1103;. &#1054;&#1090;&#1082;&#1088;&#1086;&#1074;&#1077;&#1085;&#1085;&#1077;&#1085; &#1074; &#1074;&#1099;&#1089;&#1082;&#1072;&#1079;&#1099;&#1074;&#1072;&#1085;&#1080;&#1103;&#1093;. &#1052;&#1086;&#1078;&#1077;&#1090; &#1076;&#1072;&#1090;&#1100; &#1090;&#1086;&#1095;&#1085;&#1086;&#1077; &#1086;&#1087;&#1088;&#1077;&#1076;&#1077;&#1083;&#1077;&#1085;&#1080;&#1077; &#1090;&#1086;&#1084;&#1091; &#1080;&#1083;&#1080; &#1080;&#1085;&#1086;&#1084;&#1091; &#1089;&#1083;&#1091;&#1095;&#1072;&#1102;. &#1048;&#1084;&#1077;&#1077;&#1090; &#1084;&#1085;&#1086;&#1075;&#1086; &#1076;&#1088;&#1091;&#1079;&#1077;&#1081;, &#1080; &#1087;&#1086;&#1083;&#1100;&#1079;&#1091;&#1077;&#1090;&#1089;&#1103; &#1072;&#1074;&#1090;&#1086;&#1088;&#1080;&#1090;&#1077;&#1090;&#1086;&#1084; &#1091; &#1085;&#1080;&#1093;. &#1059;&#1084;&#1077;&#1085;, &#1101;&#1085;&#1077;&#1088;&#1075;&#1080;&#1095;&#1077;&#1085;, &#1089;&#1087;&#1088;&#1072;&#1074;&#1077;&#1076;&#1083;&#1080;&#1074;.<br /><br /><br />&#1055;&#1088;&#1077;&#1076;&#1089;&#1090;&#1072;&#1074;&#1083;&#1103;&#1077;&#1084; &#1074;&#1072;&#1084; &#1090;&#1088;&#1086;&#1081;&#1082;&#1091; &#1087;&#1086;&#1073;&#1077;&#1076;&#1080;&#1090;&#1077;&#1083;&#1077;&#1081; &#1074; &#1082;&#1086;&#1085;&#1082;&#1091;&#1088;&#1089;&#1077; &#1054;&#1089;&#1077;&#1085;&#1085;&#1080;&#1081; &#1054;&#1095;&#1077;&#1088;&#1082;.<br /><br />&#1053;&#1080;&#1082;&#1072;-&#1079;&#1072;&#1085;&#1103;&#1083;&#1072; &#1087;&#1077;&#1088;&#1074;&#1086;&#1077; &#1084;&#1077;&#1089;&#1090;&#1086;. &#1053;&#1080; &#1088;&#1072;&#1079;&#1091; &#1076;&#1086; &#1101;&#1090;&#1086;&#1075;&#1086; &#1085;&#1077; &#1091;&#1095;&#1072;&#1089;&#1090;&#1074;&#1091;&#1102;&#1097;&#1072;&#1103; &#1074; &#1087;&#1086;&#1076;&#1086;&#1073;&#1085;&#1099;&#1093; &#1082;&#1086;&#1085;&#1082;&#1091;&#1088;&#1089;&#1072;&#1093;, &#1080; &#1087;&#1086;&#1073;&#1077;&#1076;&#1080;&#1074;&#1096;&#1072;&#1103;.<br /> &#1042;&#1090;&#1086;&#1088;&#1086;&#1077; &#1084;&#1077;&#1089;&#1090;&#1086; &#1079;&#1072;&#1085;&#1103;&#1083; &#1057;&#1090;&#1088;&#1072;&#1085;&#1085;&#1080;&#1082;. &#1054;&#1085; &#1076;&#1072;&#1074;&#1085;&#1086; &#1086;&#1073;&#1097;&#1072;&#1077;&#1090;&#1089;&#1103; &#1085;&#1072; &#1092;&#1086;&#1088;&#1091;&#1084;&#1077;. &#1054;&#1076;&#1080;&#1085; &#1080;&#1079; &#1077;&#1075;&#1086; &#1089;&#1090;&#1072;&#1088;&#1086;&#1078;&#1080;&#1083;&#1086;&#1074;.<br /> &#1058;&#1088;&#1077;&#1090;&#1100;&#1077; &#1084;&#1077;&#1089;&#1090;&#1086; &#1079;&#1072;&#1085;&#1103;&#1083; &#1061;&#1072;&#1082;! &#1057;&#1088;&#1072;&#1074;&#1085;&#1080;&#1090;&#1077;&#1083;&#1100;&#1085;&#1086; &#1076;&#1072;&#1074;&#1085;&#1086; &#1085;&#1072; &#1092;&#1086;&#1088;&#1091;&#1084;&#1077;. &#1054; &#1085;&#1077;&#1084; &#1090;&#1086;&#1078;&#1077; &#1084;&#1086;&#1078;&#1085;&#1086; &#1089;&#1082;&#1072;&#1079;&#1072;&#1090;&#1100; &#1095;&#1090;&#1086; &#1086;&#1085; &#1089;&#1090;&#1072;&#1088;&#1086;&#1078;&#1080;&#1083; &#1085;&#1072;&#1096;&#1077;&#1075;&#1086; &#1092;&#1086;&#1088;&#1091;&#1084;&#1072;. <br /><br />&#1055;&#1086;&#1079;&#1076;&#1088;&#1072;&#1074;&#1083;&#1103;&#1077;&#1084; &#1087;&#1086;&#1073;&#1077;&#1076;&#1080;&#1090;&#1077;&#1083;&#1077;&#1081;!<br /><br /><br />&#1057;&#1086;&#1095;&#1080;<br/>&#1086;&#1076;&#1080;&#1085; &#1080;&#1079; &#1089;&#1090;&#1072;&#1088;&#1086;&#1078;&#1080;&#1083;&#1086;&#1074; &#1092;&#1086;&#1088;&#1091;&#1084;&#1072;. &#1057;&#1080;&#1083;&#1100;&#1085;&#1072;&#1103; &#1083;&#1080;&#1095;&#1085;&#1086;&#1089;&#1090;&#1100;. &#1059;&#1084;&#1077;&#1085;, &#1089;&#1076;&#1077;&#1088;&#1078;&#1072;&#1085;, &#1074; &#1084;&#1077;&#1088;&#1091; &#1076;&#1086;&#1073;&#1088;, &#1074; &#1084;&#1077;&#1088;&#1091; &#1089;&#1091;&#1088;&#1086;&#1074;. &#1042; &#1086;&#1073;&#1097;&#1077;&#1085;&#1080;&#1080; &#1080;&#1085;&#1090;&#1077;&#1088;&#1077;&#1089;&#1077;&#1085;. &#1055;&#1086;&#1101;&#1090;, &#1089;&#1086;&#1079;&#1076;&#1072;&#1090;&#1077;&#1083;&#1100; &#1083;&#1077;&#1075;&#1077;&#1085;&#1076;&#1072;&#1088;&#1085;&#1086;&#1075;&#1086; &#1073;&#1072;&#1088;&#1072;, &#1074; &#1082;&#1086;&#1090;&#1086;&#1088;&#1086;&#1084; &#1076;&#1085;&#1080; &#1080; &#1085;&#1086;&#1095;&#1080; &#1082;&#1080;&#1087;&#1077;&#1083;&#1072; &#1078;&#1080;&#1079;&#1085;&#1100;. &#1069;&#1082;&#1089;-&#1058;&#1054;&#1055;&#1084;&#1086;&#1076;&#1077;&#1088;&#1072;&#1090;&#1086;&#1088;. &#1042;&#1089;&#1077;&#1075;&#1076;&#1072; &#1089;&#1083;&#1077;&#1076;&#1080;&#1083; &#1079;&#1072; &#1087;&#1086;&#1088;&#1103;&#1076;&#1082;&#1086;&#1084; &#1085;&#1072; &#1092;&#1086;&#1088;&#1091;&#1084;&#1077;, &#1087;&#1086;&#1076;&#1076;&#1077;&#1088;&#1078;&#1080;&#1074;&#1072;&#1083; &#1077;&#1075;&#1086;, &#1080; &#1090;&#1086;&#1075;&#1086; &#1078;&#1077; &#1090;&#1088;&#1077;&#1073;&#1086;&#1074;&#1072;&#1083; &#1086;&#1090; &#1086;&#1089;&#1090;&#1072;&#1083;&#1100;&#1085;&#1099;&#1093;. &#1054;&#1095;&#1077;&#1085;&#1100; &#1083;&#1102;&#1073;&#1080;&#1090; &#1092;&#1086;&#1088;&#1091;&#1084;, &#1080; &#1078;&#1080;&#1090;&#1077;&#1083;&#1077;&#1081;. &#1046;&#1080;&#1090;&#1077;&#1083;&#1080; &#1092;&#1086;&#1088;&#1091;&#1084;&#1072; &#1086;&#1090;&#1074;&#1077;&#1095;&#1072;&#1102;&#1090; &#1077;&#1084;&#1091; &#1090;&#1086;&#1081; &#1078;&#1077; &#1083;&#1102;&#1073;&#1086;&#1074;&#1100;&#1102;.<br/><br/>&#1043;&#1088;&#1077;&#1075;<br />&#1054;&#1073;&#1097;&#1080;&#1090;&#1077;&#1083;&#1077;&#1085;, &#1076;&#1086;&#1073;&#1088;&#1086;&#1076;&#1091;&#1096;&#1077;&#1085; &#1074;&#1089;&#1077;&#1075;&#1076;&#1072; &#1074;&#1077;&#1089;&#1077;&#1083;&#1099;&#1081;, &#1085;&#1086; &#1090;&#1072;&#1082;&#1078;&#1077; &#1088;&#1072;&#1089;&#1089;&#1091;&#1076;&#1080;&#1090;&#1077;&#1083;&#1100;&#1085;&#1099;&#1081;. &#1045;&#1075;&#1086; &#1091;&#1084;&#1077;&#1085;&#1080;&#1077; &#1089;&#1093;&#1086;&#1076;&#1080;&#1090;&#1100;&#1089;&#1103; &#1089; &#1089;&#1086;&#1074;&#1077;&#1088;&#1096;&#1077;&#1085;&#1085;&#1086; &#1088;&#1072;&#1079;&#1083;&#1080;&#1095;&#1085;&#1099;&#1084;&#1080; &#1083;&#1102;&#1076;&#1100;&#1084;&#1080; &#1074;&#1087;&#1077;&#1095;&#1072;&#1090;&#1083;&#1103;&#1077;&#1090;. &#1045;&#1089;&#1083;&#1080; &#1086;&#1085; &#1074;&#1079;&#1103;&#1083;&#1089;&#1103; &#1079;&#1072; &#1082;&#1072;&#1082;&#1086;&#1077;-&#1083;&#1080;&#1073;&#1086; &#1076;&#1077;&#1083;&#1086;, &#1090;&#1086; &#1074;&#1099;&#1087;&#1086;&#1083;&#1085;&#1080;&#1090; &#1083;&#1102;&#1073;&#1099;&#1084;&#1080; &#1089;&#1087;&#1086;&#1089;&#1086;&#1073;&#1072;&#1084;&#1080;.&#1058;&#1072;&#1082; &#1078;&#1077; &#1074;&#1082;&#1083;&#1072;&#1076;&#1099;&#1074;&#1072;&#1077;&#1090; &#1095;&#1072;&#1089;&#1090;&#1080;&#1095;&#1082;&#1091; &#1089;&#1077;&#1073;&#1103; &#1074; &#1101;&#1090;&#1086; &#1076;&#1077;&#1083;&#1086;. &#1040; &#1079;&#1085;&#1072;&#1095;&#1080;&#1090; &#1074;&#1082;&#1083;&#1072;&#1076;&#1099;&#1074;&#1072;&#1077;&#1090; &#1089;&#1074;&#1086;&#1102; &#1076;&#1091;&#1096;&#1091;.<br/><br/>&#1040;&#1084;&#1080;&#1082;<br />&#1055;&#1088;&#1080;&#1096;&#1077;&#1083; &#1085;&#1072; &#1092;&#1086;&#1088;&#1091;&#1084; &#1085;&#1077;&#1076;&#1072;&#1074;&#1085;&#1086;. &#1063;&#1091;&#1090;&#1100; &#1073;&#1086;&#1083;&#1100;&#1096;&#1077; &#1087;&#1086;&#1083;&#1075;&#1086;&#1076;&#1072; &#1085;&#1072;&#1079;&#1072;&#1076;. &#1054;&#1073;&#1097;&#1072;&#1083;&#1089;&#1103; &#1074; &#1086;&#1089;&#1085;&#1086;&#1074;&#1085;&#1086;&#1084; &#1074; &#1073;&#1072;&#1088;&#1077; &#1074; &#1041;&#1077;&#1089;&#1077;&#1076;&#1082;&#1077;. &#1055;&#1086;&#1090;&#1086;&#1084; &#1057;&#1086;&#1095;&#1080; &#1087;&#1086;&#1089;&#1090;&#1072;&#1074;&#1080;&#1083; &#1077;&#1075;&#1086; &#1084;&#1086;&#1076;&#1077;&#1088;&#1072;&#1090;&#1086;&#1088;&#1086;&#1084; &#1053;&#1086;&#1085;&#1089;&#1090;&#1086;&#1087;&#1072;, &#1073;&#1083;&#1072;&#1075;&#1086;&#1076;&#1072;&#1088;&#1103; &#1077;&#1084;&#1091;, &#1088;&#1072;&#1079;&#1076;&#1077;&#1083; &#1086;&#1073;&#1088;&#1077;&#1083; &#1087;&#1086;&#1089;&#1090;&#1086;&#1103;&#1085;&#1085;&#1099;&#1093; &#1089;&#1074;&#1086;&#1080;&#1093; &#1087;&#1086;&#1089;&#1077;&#1090;&#1080;&#1090;&#1077;&#1083;&#1077;&#1081;. &#1053;&#1077;&#1079;&#1072;&#1091;&#1088;&#1103;&#1076;&#1077;&#1085;, &#1095;&#1077;&#1089;&#1090;&#1077;&#1085;, &#1093;&#1086;&#1088;&#1086;&#1096;&#1080;&#1081; &#1076;&#1088;&#1091;&#1075;, &#1086;&#1090;&#1079;&#1099;&#1074;&#1095;&#1080;&#1074;&#1099;&#1081; &#1080; &#1076;&#1086;&#1073;&#1088;&#1099;&#1081;. &#1059;&#1084;&#1077;&#1085;, &#1091;&#1084;&#1077;&#1077;&#1090; &#1087;&#1088;&#1080;&#1085;&#1080;&#1084;&#1072;&#1090;&#1100; &#1073;&#1099;&#1089;&#1090;&#1088;&#1099;&#1077;, &#1087;&#1088;&#1072;&#1074;&#1080;&#1083;&#1100;&#1085;&#1099;&#1077; &#1088;&#1077;&#1096;&#1077;&#1085;&#1080;&#1103;. &#1045;&#1075;&#1086; &#1082;&#1088;&#1077;&#1076;&#1086; &#1085;&#1072; &#1092;&#1086;&#1088;&#1091;&#1084;&#1077; "&#1054;&#1073;&#1097;&#1072;&#1081;&#1089;&#1103; &#1089;&#1072;&#1084;, &#1080; &#1076;&#1072;&#1081; &#1086;&#1073;&#1097;&#1072;&#1090;&#1100;&#1089;&#1103; &#1076;&#1088;&#1091;&#1075;&#1080;&#1084;"<br/><br/</p>
