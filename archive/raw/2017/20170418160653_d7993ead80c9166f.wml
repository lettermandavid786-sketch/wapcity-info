#1091; &#1087;&#1083;&#1102;&#1089;&#1072;&#1085;&#1077;&#1084; &#1088;&#1077;&#1076;&#1082;&#1086;&#1074;&#1093;&#1086;&#1076;&#1103;&#1097;&#1080;&#1093;, &#1085;&#1086; &#1074;&#1089;&#1077; &#1078;&#1077; &#1085;&#1077; &#1088;&#1072;&#1079; &#1074; &#1075;&#1086;&#1076; (Nerisa, SinteS, &#1056;&#1072;&#1092;&#1072;&#1101;&#1083;&#1100;, &#1043;&#1102;, &#1040;&#1085;&#1100;&#1082;&#1072;911, &#1052;&#1072;&#1092;&#1080;&#1103;73, 4rest)... &#1082;&#1086;&#1088;&#1086;&#1095;&#1077;, &#1086;&#1082;&#1086;&#1083;&#1086; &#1076;&#1074;&#1072;&#1076;&#1094;&#1072;&#1090;&#1080;. &#1052;&#1086;&#1078;&#1077;&#1090;, &#1076;&#1072;&#1078;&#1077; &#1076;&#1074;&#1091;&#1093; &#1076;&#1102;&#1078;&#1080;&#1085;.&#160;(01:29:17 04.10.2014)
  
