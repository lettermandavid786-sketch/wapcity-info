082;&#1079;&#1072;&#1082;&#1077; &#1083;&#1077;&#1078;&#1080;&#1090; &#1079;&#1072;&#1088;&#1103;&#1078;&#1077;&#1085;&#1085;&#1099;&#1081; &#1084;&#1072;&#1082;&#1072;&#1088;&#1086;&#1074; &#1080;&#1083;&#1080; &#1087;&#1073;. &#1055;&#1072;&#1090;&#1088;&#1086;&#1085;&#1086;&#1074; &#1085;&#1077;&#1084;&#1085;&#1086;&#1075;&#1086;-&#1076;&#1077;&#1089;&#1103;&#1090;ok &#1089;&#1074;&#1076;-&#1096;&#1085;&#1099;&#1093;  &#1090;e &#1095;&#1090;o &#1074; o&#1073;o&#1081;&#1084;e, &#1089;&#1086;&#1088;&#1086;&#1082; &#1076;&#1077;&#1074;&#1103;&#1090;&#1100; &#1087;&#1080;&#1089;&#1090;&#1086;&#1083;&#1077;&#1090;&#1085;&#1099;&#1093;,&#1076;&#1074;&#1072; &#1076;&#1077;&#1089;&#1103;&#1090;&#1082;&#1072; &#1076;&#1088;&#1086;&#1073;&#1080;,&#1096;&#1077;&#1089;&#1090;&#1100;-&#1076;&#1077;&#1089;&#1103;&#1090;&#1100; &#1087;&#1091;&#1083;&#1100; &#1082; &#1088;&#1091;&#1078;&#1100;&#1102;,&#1082;&#1091;&#1088;&#1090;&#1082;&#1072; &#1080;&#1083;&#1080; &#1087;&#1083;&#1072;&#1097;. &#1040;&#1088;&#1090;&#1077;&#1092;&#1072;&#1082;&#1090;&#1099; &#1079;&#1072;&#1097;&#1080;&#1090;&#1099; &#1086;&#1090; &#1087;&#1091;&#1083;&#1100; &#1080; &#1088;&#1072;&#1076;&#1080;&#1072;&#1094;&#1080;&#1080;. &#1055;&#1103;&#1090;&#1100; &#1072;&#1087;&#1090;&#1077;&#1095;ek. &#1074; &#1073;o&#1081; c ke&#1084; &#1087;o&#1087;a&#1083;o &#1085;e &#1074;c&#1090;y&#1087;a&#1102;,&#1087;epe&#1076;&#1074;&#1080;&#1075;a&#1102;c&#1100; ckp&#1099;&#1090;&#1085;o. &#1090;&#1080;x&#1080;&#1081; &#1080; c&#1087;pa&#1074;e&#1076;&#1083;&#1080;&#1074;&#1099;&#1081; oxo&#1090;&#1085;&#1080;&#1082;...&#160;(01:05:50 25.05.2008)
