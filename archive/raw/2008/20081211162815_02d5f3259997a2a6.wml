  &#1058;&#1074;&#1086;&#1088;&#1095;&#1077;&#1089;&#1082;&#1086;&#1077; &#1086;&#1073;&#1098;&#1077;&#1076;&#1080;&#1085;&#1077;&#1085;&#1080;&#1077; "&#1050;&#1080;&#1085;&#1086;&#1089;&#1090;&#1072;&#1083;&#1082;&#1077;&#1088;" &#1072;&#1085;&#1086;&#1085;&#1089;&#1080;&#1088;&#1091;&#1077;&#1090; &#1087;&#1086;&#1083;&#1085;&#1086;&#1084;&#1077;&#1090;&#1088;&#1072;&#1078;&#1085;&#1099;&#1081; &#1092;&#1080;&#1083;&#1100;&#1084; "&#1058;&#1103;&#1078;&#x0435;&#1083;&#1072;&#1103; &#1047;&#1077;&#1084;&#1083;&#1103;" &#1087;&#1086; &#1084;&#1080;&#1088;&#1091; &#1080;&#1075;&#1088;&#1099; S.T.A.L.K.E.R.  &#1043;&#1088;&#1091;&#1087;&#1087;&#1072; &#1101;&#1085;&#1090;&#1091;&#1079;&#1080;&#1072;&#1089;&#1090;&#1086;&#1074; &#1080;&#1079; &#1056;&#1086;&#1089;&#1089;&#1080;&#1080;, &#1041;&#1077;&#1083;&#1086;&#1088;&#1091;&#1089;&#1089;&#1080;&#1080; &#1080; &#1059;&#1082;&#1088;&#1072;&#1080;&#1085;&#1099;, &#1091; &#1082;&#1086;&#1090;&#1086;&#1088;&#1099;&#1093; &#1079;&#1072; &#1087;&#1083;&#1077;&#1095;&#1072;&#1084;&#1080; &#1091;&#1078;&#1077; &#1077;&#1089;&#1090;&#1100; &#1087;&#1086; &#1086;&#1076;&#1085;&#1086;&#1084;&#1091; &#1092;&#1080;&#1083;&#1100;&#1084;&#1091; &#1085;&#1072; &#1090;&#1077;&#1084;&#1091; &#1080;&#1075;&#1088;&#1099;, &#1088;&#1077;&#1096;&#1080;&#1083;&#1080; &#1089;&#1076;&#1077;&#1083;&#1072;&#1090;&#1100; &#1089;&#1086;&#1074;&#1084;&#1077;&#1089;&#1090;&#1085;&#1099;&#1081; &#1089;&#1073;&#1086;&#1088;&#1085;&#1080;&#1082; &#1089; &#1087;&#1077;&#1088;&#1077;&#1087;&#1083;&#1077;&#1090;&#1077;&#1085;&#1080;&#1103;&#1084;&#1080; &#1089;&#1102;&#1078;&#1077;&#1090;&#1086;&#1074; &#1089;&#1074;&#1086;&#1080;&#1093; &#1082;&#1086;&#1088;&#1086;&#1090;&#1082;&#1086;&#1084;&#1077;&#1090;&#1088;&#1072;&#1078;&#1077;&#1082; &#1084;&#1077;&#1078;&#1076;&#1091; &#1089;&#1086;&#1073;&#1086;&#1081;. "&#1058;&#1103;&#1078;&#1077;&#1083;&#1072;&#1103; &#1079;&#1077;&#1084;&#1083;&#1103;". &#1042; &#1092;&#1080;&#1083;&#1100;&#1084; &#1074;&#1086;&#1081;&#1076;&#x0435;&#1090; &#1089;&#1077;&#1084;&#1100; &#1082;&#1086;&#1088;&#1086;&#1090;&#1082;&#1086;&#1084;&#1077;&#1090;&#1088;&#1072;&#1078;&#1077;&#1082;, &#1085;&#1072;&#1076; &#1085;&#1080;&#1084;&#1080; &#1073;&#1091;&#1076;&#1091;&#1090; &#1088;&#1072;&#1073;&#1086;&#1090;&#1072;&#1090;&#1100; &#1096;&#1077;&#1089;&#1090;&#1100; &#1083;&#1086;&#1082;&#1072;&#1083;&#1100;&#1085;&#1099;&#1093; &#1089;&#1098;&#x0435;&#1084;&#1086;&#1095;&#1085;&#1099;&#1093; &#1075;&#1088;&#1091;&#1087;&#1087; (&#1052;&#1086;&#1089;&#1082;&#1074;&#1072;, &#1055;&#1077;&#1090;&#1077;&#1088;&#1073;&#1091;&#1088;&#1075;, &#1050;&#1080;&#1077;&#1074;, &#1050;&#1077;&#1084;&#1077;&#1088;&#1086;&#1074;&#1086;, &#1042;&#1077;&#1083;&#1080;&#1082;&#1080;&#1077; &#1051;&#1091;&#1082;&#1080;, &#1060;&#1086;&#1082;&#1080;&#1085;&#1086; (&#1055;&#1088;&#1080;&#1084;&#1086;&#1088;&#1089;&#1082;&#1080;&#1081; &#1082;&#1088;&#1072;&#1081;))  &#1058;&#1086;&#1095;&#1085;&#1072;&#1103; &#1076;&#1072;&#1090;&#1072; &#1074;&#1099;&#1093;&#1086;&#1076;&#1072; &#1092;&#1080;&#1083;&#1100;&#1084;&#1072; &#1073;&#1091;&#1076;&#1077;&#1090; &#1086;&#1087;&#1088;&#1077;&#1076;&#1077;&#1083;&#1077;&#1085;&#1072; &#1074; &#1073;&#1083;&#1080;&#1078;&#1072;&#1081;&#1096;&#1077;&#1077; &#1074;&#1088;&#1077;&#1084;&#1103;, &#1072; &#1087;&#1086;&#1082;&#1072; &#1074;&#1089;&#1090;&#1088;&#1077;&#1095;&#1072;&#1081;&#1090;&#1077; &#1087;&#1077;&#1088;&#1074;&#1099;&#1077; &#1090;&#1088;&#1077;&#1081;&#1083;&#1077;&#1088;&#1099; ("&#1058;&#1103;&#1078;&#x0435;&#1083;&#1072;&#1103; &#1047;&#1077;&#1084;&#1083;&#1103;", "&#1055;&#1088;&#1077;&#1086;&#1073;&#1088;&#1072;&#1078;&#1077;&#1085;&#1080;&#1077;", "&#1042;&#1099;&#1073;&#1088;&#1086;&#1089;", "&#1057;&#1082;&#1080;&#1092;" &#1080; "&#1055;&#1077;&#1088;&#1074;&#1072;&#1103; &#1093;&#1086;&#1076;&#1082;&#1072;")  http://stalker-planet.ru/news/2008-09-03-156  &#160;(10:08:03 07.09.2008)
  <br/> <br/>
</p>
