#1072;&#1096;&#1077;&#1083; &#1074; &#1101;&#1090;&#1086;&#1084; &#1078;&#1091;&#1088;&#1085;&#1072;&#1083;&#1077; &#1089;&#1090;&#1072;&#1090;&#1100;&#1102; &#1086; &#1080;&#1075;&#1088;&#1077;. &#1055;&#1086;&#1095;&#1080;&#1090;&#1072;&#1083;. &#1053;&#1072;&#1095;&#1072;&#1083; &#1080;&#1075;&#1088;&#1072;&#1090;&#1100;. &#1047;&#1072; &#1086;&#1076;&#1080;&#1085; &#1076;&#1077;&#1085;&#1100; &#1079;&#1072;&#1088;&#1072;&#1073;&#1086;&#1090;&#1072;&#1083; &#1095;&#1090;&#1086;-&#1090;&#1086; &#1086;&#1082;&#1086;&#1083;&#1086; 50&#1090;&#1099;&#1089;&#1103;&#1095;. &#1048; &#1076;&#1086;&#1096;&#1077;&#1083; &#1076;&#1086; &#1072;&#1085;&#1090;&#1077;&#1085;. &#1044;&#1072; &#1077;&#1097;&#1077; &#1074;&#1086;&#1087;&#1088;&#1086;&#1089;. &#1044;&#1088;&#1091;&#1079;&#1100;&#1103; &#1074;&#1080;&#1076;&#1077;&#1083;&#1080; &#1087;&#1086;&#1095;&#1090;&#1080; &#1074;&#1089;&#1077; &#1082;&#1086;&#1085;&#1094;&#1086;&#1074;&#1082;&#1080;. &#1048; &#1089; &#1079;&#1086;&#1083;&#1086;&#1090;&#1086;&#1084;. &#1048; &#1082;&#1086;&#1075;&#1076;&#1072; &#1086;&#1085; &#1089;&#1083;&#1077;&#1087;&#1099;&#1084; &#1089;&#1090;&#1072;&#1085;&#1086;&#1074;&#1080;&#1090;&#1089;&#1103; &#1080; &#1090;.&#1076;. &#1048; &#1085;&#1072;&#1089;&#1090;&#1086;&#1103;&#1097;&#1091;&#1102; &#1082;&#1086;&#1085;&#1094;&#1086;&#1074;&#1082;&#1091; &#1090;&#1086;&#1078;&#1077;. &#1040; &#1103; &#1087;&#1086;&#1089;&#1083;&#1077; 16&#1083;&#1072;&#1073;&#1086;&#1088;&#1072;&#1090;&#1086;&#1088;&#1080;&#1080; &#1096;&#1077;&#1083; &#1085;&#1072; &#1082;&#1086;&#1088;&#1076;&#1086;&#1085; &#1082; &#1087;&#1088;&#1086;&#1074;&#1086;&#1076;&#1085;&#1080;&#1082;&#1091;. &#1055;&#1086; &#1089;&#1086;&#1074;&#1077;&#1090;&#1091; &#1076;&#1088;&#1091;&#1079;&#1077;&#1081;. &#1053;&#1086; &#1077;&#1075;&#1086; &#1090;&#1072;&#1084; &#1085;&#1077; &#1085;&#1072;&#1093;&#1086;&#1076;&#1080;&#1083;. &#1052;&#1086;&#1078;&#1077;&#1090; &#1103; &#1095;&#1090;&#1086;-&#1090;&#1086; &#1085;&#1077; &#1087;&#1088;&#1072;&#1074;&#1080;&#1083;&#1100;&#1085;&#1086; &#1076;&#1077;&#1083;&#1072;&#1102;? &#1056;&#1077;&#1073;&#1103;&#1090;&#1072; &#1089;&#1082;&#1072;&#1079;&#1072;&#1083;&#1080; &#1095;&#1090;&#1086; &#1087;&#1086;&#1089;&#1083;&#1077; 16 &#1076;&#1086;&#1083;&#1078;&#1085;&#1072; &#1087;&#1086;&#1103;&#1074;&#1080;&#1090;&#1089;&#1103; &#1084;&#1080;&#1089;&#1089;&#1080;&#1103; &#1085;&#1072;&#1081;&#1090;&#1080; &#1087;&#1088;&#1086;&#1074;&#1086;&#1076;&#1085;&#1080;&#1082;&#1072;. &#1053;&#1086; &#1089;&#1082;&#1086;&#1083;&#1100;&#1082;&#1086; &#1088;&#1072;&#1079; &#1087;&#1088;&#1086;&#1093;&#1086;&#1076;&#1080;&#1083; &#1085;&#1080; &#1088;&#1072;&#1079;&#1091; &#1089; &#1085;&#1080;&#1084; &#1085;&#1077; &#1074;&#1089;&#1090;&#1088;&#1077;&#1095;&#1072;&#1083;&#1089;&#1103;. &#1042; &#1095;&#1077;&#1084; &#1079;&#1072;&#1082;&#1083;&#1102;&#1095;&#1072;&#1077;&#1090;&#1089;&#1103; &#1092;&#1089;&#1073; &#1087;&#1088;&#1086;&#1073;&#1083;&#1077;&#1084;&#1072;?&#160;(09:16:43 18.04.2008)
