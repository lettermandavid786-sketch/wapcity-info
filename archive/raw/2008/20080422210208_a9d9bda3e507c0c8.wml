  &#1058;&#1072;&#1082; &#1084;&#1077;&#1089;&#1103;&#1094; &#1085;&#1072;&#1079;&#1072;&#1076; &#1077;&#1097;&#1077; &#1103;&#1074;&#1086;&#1088;&#1089;&#1082;&#1080;&#1081; &#1089;&#1082;&#1072;&#1079;&#1072;&#1083; &#1095;&#1090;&#1086; 29 &#1072;&#1074;&#1075;&#1091;&#1089;&#1090;&#1072; &#1074;&#1099;&#1087;&#1091;&#1089;&#1090;&#1103;&#1090; &#1086;&#1076;&#1085;&#1086;&#1074;&#1088;&#1077;&#1084;&#1077;&#1085;&#1085;&#1086; &#1087;&#1086; &#1074;&#1089;&#1077;&#1084;&#1091; &#1084;&#1080;&#1088;&#1091;. &#1044;&#1072;,&#1080; &#1077;&#1097;&#1077;. &#1050;&#1072;&#1082;&#1072;&#1103; &#1074;&#1077;&#1088;&#1089;&#1080;&#1103; &#1072;&#1084;&#1082; &#1091; &#1090;&#1077;&#1073;&#1103;,&#1095;&#1090;&#1086; &#1085;&#1072;&#1077;&#1084;&#1085;&#1080;&#1082;&#1080; &#1085;&#1072; &#1089;&#1074;&#1072;&#1083;&#1082;&#1077; &#1073;&#1077;&#1075;&#1072;&#1102;&#1090;,&#1076;&#1072; &#1077;&#1097;&#1077; &#1080; &#1076;&#1088;&#1091;&#1079;&#1100;&#1103;&#1084;&#1080; &#1089;&#1090;&#1072;&#1085;&#1086;&#1074;&#1103;&#1090;&#1089;&#1103; &#1087;&#1086;&#1089;&#1083;&#1077; &#1090;&#1086;&#1075;&#1086; &#1082;&#1072;&#1082; &#1090;&#1099; &#1073;&#1072;&#1085;&#1076;&#1080;&#1090;&#1086;&#1074;,&#1095;&#1090;&#1086; &#1080;&#1093; &#1086;&#1073;&#1080;&#1078;&#1072;&#1083;&#1080;,&#1091;&#1073;&#1080;&#1074;&#1072;&#1077;&#1096;&#1100;? &#1059; &#1084;&#1077;&#1085;&#1103; &#1090;&#1072;&#1082;&#1086;&#1075;&#1086; &#1085;&#1077; &#1073;&#1099;&#1083;&#1086; &#1077;&#1097;&#1077;. &#1050;&#1088;&#1086;&#1074;&#1086;&#1089;&#1086;&#1089;&#1072; &#1074;&#1086;&#1090; &#1085;&#1072; &#1089;&#1074;&#1072;&#1083;&#1082;&#1077; &#1074;&#1080;&#1076;&#1077;&#1083; &#1074;&#1086; &#1074;&#1088;&#1077;&#1084;&#1103; &#1092;&#1088;&#1080;&#1087;&#1083;&#1077;&#1103;. &#1040; &#1085;&#1072;&#1077;&#1084;&#1085;&#1080;&#1082;&#1086;&#1074; &#1085;&#1077;&#1090;. &#1040;&#1093;,&#1076;&#1072;,17 &#1084;&#1085;&#1077;. &#1042; &#1072;&#1085;&#1082;&#1077;&#1090;&#1077; &#1078; &#10