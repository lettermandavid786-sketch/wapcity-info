  <img src="/i/mes.gif" class="ico" alt="*"/>&#160;
  &#1042;&#1095;&#1077;&#1088;&#1072; &#1091;&#1089;&#1090;&#1072;&#1085;&#1072;&#1074;&#1083;&#1080;&#1074;&#1072;&#1083; &#1080;&#1075;&#1088;&#1091; &#1086;&#1076;&#1085;&#1086;&#1084;&#1091; 10-&#1083;&#1077;&#1090;&#1085;&#1077;&#1084;&#1091; &#1087;&#1072;&#1094;&#1072;&#1085;&#1091;.  &#1082;&#1086;&#1084;&#1087;&#1100;&#1102;&#1090;&#1077;&#1088;: &#1082;&#1072;&#1082;&#1086;&#1081;-&#1090;&#1086; &#1089;&#1077;&#1083;&#1077;&#1088;&#1086;&#1085; &#1089;&#1090;&#1072;&#1088;&#1099;&#1081;,&#1086;&#1082;&#1086;&#1083;&#1086; 2.2 &#1075;&#1075;&#1094;, 512 &#1084;&#1073; &#1086;&#1087;&#1077;&#1088;&#1072;&#1090;&#1080;&#1074;&#1099;,&#1080; &#1074;&#1080;&#1076;&#1077;&#1086;-&#1075;&#1074;&#1086;&#1079;&#1076;&#1100; &#1087;&#1088;&#1086;&#1075;&#1088;&#1072;&#1084;&#1084;&#1099;: G-force 6200 ! &#1071; &#1077;&#1097;&#1077; &#1085;&#1080;&#1082;&#1086;&#1075;&#1076;&#1072; &#1085;&#1077; &#1074;&#1080;&#1076;&#1077;&#1083; &#1090;&#1072;&#1082;&#1080;&#1093; &#1090;&#1086;&#1088;&#1084;&#1086;&#1079;&#1086;&#1074;. &#1040;&#1073;&#1089;&#1086;&#1083;&#1102;&#1090;&#1085;&#1086; &#1074;&#1089;&#1077; &#1091;&#1073;&#1088;&#1072;&#1085;&#1086; &#1085;&#1072; &#1084;&#1080;&#1085;&#1080;&#1084;&#1091;&#1084;-&#1076;&#1086; &#1091;&#1087;&#1086;&#1088;&#1072; &#1074;&#1083;&#1077;&#1074;&#1086;. &#1048; &#1074;&#1089;&#1077; &#1088;&#1072;&#1074;&#1085;&#1086; &#1080;&#1075;&#1088;&#1072; &#1080;&#1076;&#1077;&#1090; &#1085;&#1072; &#1091;&#1088;&#1086;&#1074;&#1085;&#1077; 10&#1092;&#1087;&#1089;. &#1043;&#1088;&#1072;&#1092;&#1080;&#1082;&#1072;-&#1085;&#1072; &#1091;&#1088;&#1086;&#1074;&#1085;&#1077; &#1085;&#1072;&#1074;&#1077;&#1088;&#1085;&#1086;&#1077; &#1087;&#1077;&#1088;&#1074;&#1086;&#1075;&#1086; &#1093;&#1072;&#1083;&#1092;&#1083;&#1072;&#1081;&#1092;&#1072;. &#1042;&#1089;&#1077; &#1090;&#1077;&#1082;&#1089;&#1090;&#1091;&#1088;&#1099; &#1088;&#1072;&#1079;&#1084;&#1072;&#1079;&#1072;&#1085;&#1099; &#1080; &#1084;&#1091;&#1090;&#1085;&#1099;,&#1090;&#1088;&#1072;&#1074;&#1099; &#1095;&#1091;&#1090;&#1100;-&#1095;&#1091;&#1090;&#1100;,&#1074;&#1080;&#1076;&#1080;&#1084;&#1086;&#1089;&#1090;&#1100;-60-.100 &#1084;&#1077;&#1090;&#1088;&#1086;&#1074;. &#1050;&#1089;&#1090;&#1072;&#1090;&#1080;,&#1077;&#1097;&#1077; &#1088;&#1072;&#1079; &#1087;&#1086;&#1076;&#1090;&#1074;&#1077;&#1088;&#1076;&#1080;&#1083;&#1086;&#1089;&#1100;,&#1095;&#1090;&#1086; &#1089;&#1090;&#1072;&#1083;&#1082;&#1077;&#1088;-&#1091;&#1084;&#1085;&#1072;&#1103; &#1080;&#1075;&#1088;&#1072;,&#1072; &#1085;&#1077; &#1090;&#1091;&#1087;&#1072;&#1103; &#1089;&#1090;&#1088;&#1077;&#1083;&#1103;&#1083;&#1082;&#1072;. &#1044;&#1072;&#1078;&#1077; &#1090;&#1086;&#1090;,&#1082;&#1086;&#1090;&#1086;&#1088;&#1099;&#1081; &#1089;&#1077;&#1081;&#1095;&#1072;&#1089; &#1077;&#1089;&#1090;&#1100;,&#1072; &#1085;&#1077; &#1090;&#1086;&#1090;,&#1082;&#1086;&#1090;&#1086;&#1088;&#1099;&#1081; &#1087;&#1083;&#1072;&#1085;&#1080;&#1088;&#1086;&#1074;&#1072;&#1083;&#1089;&#1103;. &#1055;&#1072;&#1094;&#1072;&#1085;,&#1080;&#1075;&#1088;&#1072;&#1074;&#1096;&#1080;&#1081; &#1076;&#1086; &#1090;&#1086;&#1075;&#1086; &#1090;&#1086;&#1083;&#1100;&#1082;&#1086; &#1074; &#1082;&#1086;&#1085;&#1090;&#1088;&#1091; &#1080; &#1087;&#1088;&#1086;&#1095;&#1080;e &#1083;&#1080;&#1085;e&#1081;&#1085;&#1099;e &#1080;&#1075;p&#1099;,c&#1085;a&#1095;a&#1083;a &#1076;a&#1078;e &#1085;e &#1087;&#1086;&#1085;&#1103;&#1083;,ky&#1076;a e&#1084;y &#1080;&#1076;&#1090;&#1080;. &#1103; e&#1084;y e&#1083;e o&#1073;&#1098;&#1103;c&#1085;&#1080;&#1083;: &#1101;&#1090;o &#1085;e &#1080;&#1075;pa,&#1101;&#1090;o &#1078;&#1080;&#1079;&#1085;&#1100;. kc&#1090;a&#1090;&#1080;,&#1080;&#1076;&#1090;&#1080;-&#1090;o e&#1084;y &#1085;y&#1078;&#1085;o &#1073;&#1099;&#1083;o &#1079;a &#1085;o&#1074;o&#1081; &#1087;a&#1084;&#1103;&#1090;&#1100;&#1102;. c&#1090;o&#1087;y&#1076;o&#1074;.&#160;(10:17:42 21.06.2008)
