  &#1071; &#1095;&#1080;&#1090;&#1072;&#1083; &#1087;&#1088;&#1080;&#1095;&#x0435;&#1084; &#1074;&#1089;&#1077; &#1086;&#1090; &#1082;&#1072;&#1086;&#1088;&#1082;&#1080; &#1076;&#1086; &#1082;&#1086;&#1088;&#1082;&#1080; &#1080;&#1093; &#1091;&#1078; &#1096;&#1090;&#1091;&#1082; 20 &#1087;&#1088;&#1080;&#1084;&#1077;&#1088;&#1085;&#1086;.&#1042;&#1086;&#1090; &#1087;&#1086; &#1101;&#1090;&#1086;&#1084;&#1091; &#1072;&#1076;&#1088;&#1077;&#1089;&#1086;&#1095;&#1082;&#1091; &#1080;&#1093; &#1084;&#1086;&#1078;&#1085;&#1086; &#1089;&#1082;&#1072;&#1095;&#1072;&#1090;&#1100; http://www.xpe.ru/book/index.php?series&se=3&w=0 &#1074;&#1085;&#1080;&#1079;&#1091; &#1084;&#1086;&#1078;&#1085;&#1086; &#1084;&#1086;&#1090;&#1072;&#1090;&#1100; &#1089;&#1090;&#1088;&#1072;&#1085;&#1080;&#1094;&#1099; &#1085;&#1072; &#1076;&#1072;&#1083;&#1077;&#1077; &#1082;&#1089;&#1090;&#1072;&#1090;&#1080; &#1082;&#1072;&#1082; &#1087;&#1086; &#1084;&#1085;&#1077; &#1083;&#1080;&#1085;&#1080;&#1103; &#1086;&#1075;&#1085;&#1103; &#1089;&#1072;&#1084;&#1072;&#1103; &#1091;&#1076;&#1072;&#1095;&#1085;&#1072;&#1103; &#1082;&#1085;&#1080;&#1075;&#1072; &#1074; &#1089;&#1077;&#1088;&#1080;&#1080;. &#160;(19:25:54 11.09.2008)
