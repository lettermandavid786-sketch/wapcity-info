<p>
  <img src="/i/ofl.gif" class="ico" alt="*"/>&#160;
  <a href="/m/f/11/t/1152/tid/1717">
    <img src="/i/pr.gif" class="ico" alt="*"/>&#160;
  </a>
  <a href="/user/id/1717/frm/m/f/11/tp/1152">Stalker</a>&#160;&#160;
  <img src="/i/mes.gif" class="ico" alt="*"/>&#160;
  &#1058;&#1099; &#1085;&#1072;&#1074;&#1077;&#1088;&#1085;&#1086;&#1077; &#1087;&#1088;&#1086; &#1089;&#1090;&#1072;&#1083;&#1082;&#1077;&#1088;: &#1095;&#1080;&#1089;&#1090;&#1086;&#1077; &#1085;&#1077;&#1073;&#1086; &#1075;&#1086;&#1074;&#1086;&#1088;&#1080;&#1096;&#1100;,&#1080;&#1073;&#1086; &#1089;&#1090;&#1072;&#1083;&#1082;&#1077;&#1088; 2 &#1077;&#1097;&#1077; &#1085;&#1077; &#1074;&#1099;&#1096;&#1077;&#1083;. &#1063;&#1080;&#1089;&#1090;&#1086;&#1077; &#1085;&#1077;&#1073;&#1086;-&#1101;&#1090;&#1086; &#1089;&#1090;&#1072;&#1083;&#1082;&#1077;&#1088; &#1074;&#1077;&#1088;&#1089;&#1080;&#1080; 1.5.0 (&#1080;&#1083;&#1080; 1.5.01, &#1082;&#1086;&#1090;&#1086;&#1088;&#1091;&#1102; &#1073;&#1091;&#1076;&#1091;&#1090; &#1087;&#1088;&#1086;&#1076;&#1072;&#1074;&#1072;&#1090;&#1100; &#1079;&#1072; &#1075;&#1088;&#1072;&#1085;&#1080;&#1094;&#1077;&#1081;). &#1058;&#1086; &#1077;&#1089;&#1090;&#1100; &#1075;&#1083;&#1091;&#1073;&#1086;&#1095;&#1072;&#1081;&#1096;&#1077; &#1091;&#1089;&#1086;&#1074;&#1077;&#1088;&#1096;&#1077;&#1085;&#1089;&#1090;&#1074;&#1086;&#1074;&#1072;&#1085;&#1085;&#1099;&#1081; &#1089;&#1090;&#1072;&#1083;&#1082;&#1077;&#1088;: &#1090;&#1077;&#1085;&#1100; &#1095;&#1077;&#1088;&#1085;&#1086;&#1073;&#1099;&#1083;&#1103;. &#1053;&#1086;&#1074;&#1099;&#1081; &#1076;&#1074;&#1080;&#1078;&#1086;&#1082; &#1089; &#1087;&#1086;&#1076;&#1076;&#1077;&#1088;&#1078;&#1082;&#1086;&#1081; &#1076;&#1080;&#1088;&#1077;&#1082;&#1090; 10,&#1085;&#1086;&#1074;&#1099;&#1077; &#1083;&#1086;&#1082;&#1072;&#1094;&#1080;&#1080;,&#1085;&#1086;&#1074;&#1099;&#1077; &#1087;&#1072;&#1088;&#1072;&#1084;&#1077;&#1090;&#1088;&#1099; &#1087;&#1086;&#1074;&#1077;&#1076;&#1077;&#1085;&#1080;&#1103; &#1087;&#1077;&#1088;&#1089;&#1086;&#1085;&#1072;&#1078;&#1077;&#1081; &#1080; &#1093;&#1072;&#1088;&#1072;&#1082;&#1090;&#1077;&#1088;&#1080;&#1089;&#1090;&#1080;&#1082;&#1080; &#1080;&#1075;&#1088;&#1099; &#1074; &#1086;&#1073;&#1097;&#1077;&#1084; &#1080; &#1094;&#1077;&#1083;&#1086;&#1084;. &#1053;&#1086; &#1074;&#1086;&#1090; &#1095;&#1090;&#1086; &#1084;&#1085;&#1077; &#1085;&#1077; &#1087;&#1086;&#1085;&#1088;&#1072;&#1074;&#1080;&#1083;&#1086;&#1089;&#1100;: 
1. &#1057;&#1083;&#1080;&#1096;&#1082;&#1086;&#1084; &#1084;&#1085;&#1086;&#1075;&#1086; &#1083;&#1102;&#1076;&#1077;&#1081;. &#1053;&#1072; &#1073;&#1086;&#1083;&#1086;&#1090;&#1077; &#1080; &#1082;&#1086;&#1088;&#1076;&#1086;&#1085;&#1077; &#1090;&#1100;&#1084;&#1072;-&#1090;&#1100;&#1084;&#1091;&#1097;&#1072;&#1103; &#1087;&#1088;&#1086;&#1089;&#1090;&#1086;. 
2. &#1042;&#1086;&#1081;&#1085;&#1072; &#1075;&#1088;&#1091;&#1087;&#1087;&#1080;&#1088;&#1086;&#1074;&#1086;&#1082; &#1080; &#1090;&#1077;&#1093;&#1085;&#1080;&#1095;&#1077;&#1089;&#1082;&#1080;&#1077; &#1086;&#1095;&#1082;&#1080;. &#1057;&#1090;&#1086;&#1080;&#1090; &#1079;&#1072;&#1093;&#1074;&#1072;&#1090;&#1080;&#1090;&#1100; &#1085;&#1077;&#1089;&#1082;&#1086;&#1083;&#1100;&#1082;&#1086; &#1090;&#1086;&#1095;&#1077;&#1082; &#1085;&#1072; &#1083;&#1086;&#1082;&#1072;&#1094;&#1080;&#1080; (&#1095;&#1080;&#1089;&#1083;&#1077;&#1085;&#1085;&#1086;&#1077; &#1087;&#1088;&#1077;&#1074;&#1086;&#1089;&#1093;&#1086;&#1076;&#1089;&#1090;&#1074;&#1086;) &#1082;&#1072;&#1082; &#1089;&#1088;&#1077;&#1076;&#1080; &#1089;&#1090;&#1072;&#1083;&#1082;&#1077;&#1088;&#1086;&#1074; &#1087;&#1086;&#1103;&#1074;&#1083;&#1103;&#1102;&#1090;&#1089;&#1103; (&#1087;&#1088;&#1080;&#1093;&#1086;&#1076;&#1103;&#1090; &#1086;&#1090;&#1082;&#1091;&#1076;&#1072;-&#1090;&#1086;) &#1083;&#1091;&#1095;&#1096;&#1077; &#1101;&#1082;&#1080;&#1087;&#1080;&#1088;&#1086;&#1074;&#1072;&#1085;&#1085;&#1099;&#1077; &#1073;&#1086;&#1081;&#1094;&#1099;. &#1042;&#1087;&#1083;&#1086;&#1090;&#1100; &#1076;&#1086; &#1090;&#1077;&#1088;&#1084;&#1080;&#1085;&#1072;&#1090;&#1086;&#1088;&#1086;&#1074; &#1074; &#1101;&#1082;&#1079;&#1086;&#1089;&#1082;&#1077;&#1083;&#1077;&#1090;&#1072;&#1093; &#1080; &#1089; "&#1074;&#1080;&#1085;&#1090;&#1086;&#1088;&#1077;&#1079;&#1072;&#1084;&#1080;". &#1069;&#1090;&#1086; &#1085;&#1077; &#1077;&#1089;&#1090;&#1100; &#1093;&#1086;&#1088;&#1086;&#1096;&#1086; &#1080; &#1085;&#1077; &#1088;&#1077;&#1072;&#1083;&#1080;&#1089;&#1090;&#1080;&#1095;&#1085;&#1086;. &#1069;&#1090;&#1086; &#1084;&#1077;&#1085;&#1103; &#1088;&#1072;&#1089;&#1089;&#1090;&#1088;&#1086;&#1080;&#1083;&#1086;. 
3. &#1054;&#1095;&#1077;&#1085;&#1100; &#1084;&#1085;&#1086;&#1075;&#1086; &#1075;&#1083;&#1102;&#1082;&#1086;&#1074;. &#1054;&#1095;&#1077;&#1085;&#1100;. &#1053;&#1072; &#1087;&#1086;&#1088;&#1103;&#1076;&#1086;&#1082; &#1073;&#1086;&#1083;&#1100;&#1096;&#1077; &#1095;&#1077;&#1084; &#1074; &#1087;&#1077;&#1088;&#1074;&#1086;&#1081; &#1095;&#1072;&#1089;&#1090;&#1080;. &#1059; &#1084;&#1085;&#1086;&#1075;&#1080;&#1093; &#1073;&#1083;&#1080;&#1078;&#1077; &#1082; &#1089;&#1077;&#1088;&#1077;&#1076;&#1080;&#1085;&#1077; &#1080;&#1075;&#1088;&#1099; &#1085;&#1072;&#1095;&#1080;&#1085;&#1072;&#1102;&#1090; &#1079;&#1072;&#1087;&#1080;&#1089;&#1099;&#1074;&#1072;&#1090;&#1100;&#1089;&#1103; "&#1073;&#1080;&#1090;&#1099;&#1077;" &#1089;&#1086;&#1093;&#1088;&#1072;&#1085;&#1077;&#1085;&#1080;&#1103;,&#1082;&#1086;&#1090;&#1086;&#1088;&#1099;&#1077; &#1085;&#1077;&#1074;&#1086;&#1079;&#1084;&#1086;&#1078;&#1085;&#1086; &#1079;&#1072;&#1075;&#1088;&#1091;&#1079;&#1080;&#1090;&#1100;- &#1074;&#1099;&#1083;&#1077;&#1090;&#1072;&#1077;&#1090; &#1080;&#1075;&#1088;&#1072;. &#1069;&#1090;&#1086; &#1085;&#1077;&#1080;&#1089;&#1087;&#1088;&#1072;&#1074;&#1080;&#1084;&#1086;. &#1058;&#1086;&#1083;&#1100;&#1082;&#1086; &#1087;&#1072;&#1090;&#1095;&#1077;&#1084;,&#1082;&#1086;&#1090;&#1086;&#1088;&#1099;&#1081; &#1087;&#1086;&#1082;&#1072; &#1090;&#1086;&#1083;&#1100;&#1082;&#1086; &#1086;&#1076;&#1080;&#1085; &#1080; &#1087;&#1086;&#1084;&#1086;&#1075;&#1072;&#1077;&#1090; &#1087;&#1083;&#1086;&#1093;&#1086;. &#1053;&#1091;&#1078;&#1085;&#1086; &#1078;&#1076;&#1072;&#1090;&#1100; &#1089;&#1083;&#1077;&#1076;&#1091;&#1102;&#1097;&#1077;&#1075;&#1086;,&#1080;&#1073;&#1086; &#1074; &#1080;&#1075;&#1088;&#1077; &#1075;&#1083;&#1102;&#1082; &#1085;&#1072; &#1075;&#1083;&#1102;&#1082;&#1077; &#1080; &#1074;&#1099;&#1083;&#1077;&#1090;&#1086;&#1084; &#1087;&#1086;&#1075;&#1086;&#1085;&#1103;&#1077;&#1090;. &#1040; &#1074; &#1086;&#1089;&#1090;&#1072;&#1083;&#1100;&#1085;&#1086;&#1084;- &#1093;&#1086;&#1088;&#1086;&#1096;&#1086;. &#1054;&#1075;&#1088;&#1086;&#1084;&#1085;&#1072;&#1103; (&#1082;&#1074;&#1072;&#1076;&#1088;&#1072;&#1090; &#1089;&#1086; &#1089;&#1090;&#1086;&#1088;&#1086;&#1085;&#1086;&#1081; &#1076;&#1083;&#1080;&#1085;&#1086;&#1081; &#1089; &#1076;&#1074;&#1072; &#1082;&#1086;&#1088;&#1076;&#1086;&#1085;&#1072;) &#1083;&#1086;&#1082;&#1072;&#1094;&#1080;&#1103; &#1073;&#1086;&#1083;&#1086;&#1090;&#1072;. &#1053;&#1077;&#1084;&#1085;&#1086;&#1075;&#1086; &#1088;&#1072;&#1089;&#1096;&#1080;&#1088;&#1077;&#1085;&#1099; &#1082;&#1086;&#1088;&#1076;&#1086;&#1085; &#1080; &#1089;&#1074;&#1072;&#1083;&#1082;&#1072;. &#1045;&#1089;&#1090;&#1100; &#1085;&#1086;&#1074;&#1099;&#1077; &#1090;&#1086;&#1095;&#1082;&#1080; &#1087;&#1077;&#1088;&#1077;&#1093;&#1086;&#1076;&#1072; &#1084;&#1077;&#1078;&#1076;&#1091; &#1083;&#1086;&#1082;&#1072;&#1094;&#1080;&#1103;&#1084;&#1080;. &#1043;&#1088;&#1072;&#1092;&#1080;&#1082;&#1072; &#1082;&#1088;&#1072;&#1089;&#1080;&#1074;&#1072;.&#160;(11:43:29 25.08.2008)
  <br/> <br/>
</p>
