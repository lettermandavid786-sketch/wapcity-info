  </a>&#160;&#160;
  <img src="/i/mes.gif" class="ico" alt="*"/>&#160;
  &#1053;&#1091;, &#1076;&#1083;&#1103; &#1087;&#1086;&#1078;&#1072;&#1088;&#1080;&#1097;&#1072; &#1093;&#1074;&#1072;&#1090;&#1080;&#1083;&#1086; &#1074;&#1089;&#1077;&#1075;&#1086; &#1085;&#1077;&#1089;&#1082;&#1086;&#1083;&#1100;&#1082;&#1080;&#1093; &#1095;&#1077;&#1083;&#1086;&#1074;&#1077;&#1082; :). &#1057; &#1091;&#1082;&#1088;&#1072;&#1080;&#1085;&#1089;&#1082;&#1086;&#1081; &#1089;&#1090;&#1086;&#1088;&#1086;&#1085;&#1099; - &#1044;&#1091;&#1095;&#1086;, &#1051;&#1077;&#1085;&#1100;, &#1064;&#1072;&#1073;&#1077;&#1088;. &#1057; &#1088;&#1086;&#1089;&#1089;&#1080;&#1081;&#1089;&#1082;&#1086;&#1081; - &#1103; (&#1080;&#1079;&#1074;&#1080;&#1085;&#1080;&#1090;&#1077;, &#1085;&#1086; &#1103; &#1082;&#1088;&#1099;&#1084;&#1095;&#1072;&#1085;&#1080;&#1085; &#1080; &#1085;&#1077; &#1083;&#1102;&#1073;&#1080;&#1090;&#1100; &#1059;&#1082;&#1088;&#1072;&#1080;&#1085;&#1091; &#1086;&#1089;&#1085;&#1086;&#1074;&#1072;&#1085;&#1080;&#1103; &#1077;&#1089;&#1090;&#1100;), &#1059;&#1085;&#1080;&#1074;&#1077;&#1088; &#1086;&#1085; &#1078;&#1077; Leviy &#1080; &#1040;&#1084;&#1086;&#1088;&#1077;&#1090;&#1080;. &#1058;&#1091;&#1090; &#1077;&#1097;&#1077; &#1076;&#1072;&#1074;&#1085;&#1103;&#1103; &#1083;&#1080;&#1095;&#1085;&#1086;&#1089;&#1090;&#1085;&#1072;&#1103; &#1085;&#1077;&#1087;&#1088;&#1080;&#1103;&#1079;&#1085;&#1100; &#1059;&#1085;&#1080;&#1074;&#1077;&#1088; - &#1051;&#1077;&#1085;&#1100;. &#1057;&#1077;&#1081;&#1095;&#1072;&#1089;... &#1055;&#1086; &#1092;&#1072;&#1082;&#1090;&#1091; &#1044;&#1091;&#1095;&#1086; &#1080; &#1051;&#1077;&#1085;&#1100; &#1089; &#1085;&#1072;&#1084;&#1080; &#1085;&#1077; &#1086;&#1073;&#1097;&#1072;&#1102;&#1090;&#1089;&#1103;. &#1059;&#1085;&#1080;&#1074;&#1077;&#1088;&#1072; &#1074; &#1075;&#1088;&#1091;&#1087;&#1087;&#1077;, &#1074;&#1087;&#1088;&#1086;&#1095;&#1077;&#1084;, &#1090;&#1086;&#1078;&#1077; &#1085;&#1077;&#1090; &#1080; &#1085;&#1077; &#1073;&#1091;&#1076;&#1077;&#1090;. &#1054;&#1089;&#1090;&#1072;&#1083;&#1100;&#1085;&#1099;&#1077; &#1083;&#1102;&#1076;&#1080;, &#1074; &#1087;&#1088;&#1080;&#1085;&#1094;&#1080;&#1087;&#1077;, &#1087;&#1086;&#1084;&#1080;&#1088;&#1080;&#1083;&#1080;&#1089;&#1100; &#1083;&#1080;&#1073;&#1086; &#1080; &#1085;&#1077; &#1089;&#1089;&#1086;&#1088;&#1080;&#1083;&#1080;&#1089;&#1100;. &#1057;&#1082;&#1072;&#1078;&#1077;&#1084;, &#1083;&#1080;&#1095;&#1085;&#1086; &#1103; &#1085;&#1080; &#1089; &#1058;&#1088;&#1077;&#1084;&#1086;&#1088;, &#1085;&#1080; &#1089; &#1043;&#1088;&#1077;&#1075;&#1086;&#1084;, &#1085;&#1080; &#1089; &#1060;&#1086;&#1083;&#1072;&#1082;&#1089;&#1086;&#1084; &#1085;&#1077; &#1089;&#1089;&#1086;&#1088;&#1080;&#1083;&#1089;&#1103;... &#1085;&#1086; &#1086;&#1089;&#1082;&#1086;&#1088;&#1073;&#1083;&#1103;&#1090;&#1100; &#1084;&#1086;&#1102; &#1084;&#1072;&#1083;&#1091;&#1102; &#1088;&#1086;&#1076;&#1080;&#1085;&#1091; &#1050;&#1088;&#1099;&#1084; &#1074;&#1089;&#1077; &#1078; &#1085;&#1077; &#1076;&#1072;&#1084;. &#1055;&#1088;&#1086;&#1089;&#1090;&#1086; &#1085;&#1077; &#1086;&#1073;&#1089;&#1091;&#1078;&#1076;&#1072;&#1077;&#1084; &#1088;&#1072;&#1079;&#1074;&#1077;&#1088;&#1085;&#1091;&#1090;&#1086; &#1101;&#1090;&#1091; &#1090;&#1077;&#1084;&#1091; &#1080; &#1074;&#1089;&#1077;.&#160;(00:57:17 08.12.2016)
  
