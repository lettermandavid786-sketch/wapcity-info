  &#1040; &#1089;&#1074;&#1072;&#1089;&#1090;&#1080;&#1082;&#1072; &#1087;&#1086; &#1073;&#1086;&#1083;&#1100;&#1096;&#1086;&#1084;&#1091; &#1089;&#1095;&#1077;&#1090;&#1091; - &#1089;&#1080;&#1084;&#1074;&#1086;&#1083; &#1057;&#1086;&#1083;&#1085;&#1094;&#1072;. &#1058;&#1088;&#1072;&#1076;&#1080;&#1094;&#1080;&#1086;&#1085;&#1085;&#1072;&#1103; &#1080;&#1089;&#1090;&#1086;&#1088;&#1080;&#1103; &#1089;&#1095;&#1080;&#1090;&#1072;&#1077;&#1090;, &#1095;&#1090;&#1086; &#1080;&#1079;&#1085;&#1072;&#1095;&#1072;&#1083;&#1100;&#1085;&#1086; &#1101;&#1090;&#1086; &#1080;&#1079; &#1080;&#1085;&#1076;&#1080;&#1081;&#1089;&#1082;&#1086;&#1081; &#1082;&#1091;&#1083;&#1100;&#1090;&#1091;&#1088;&#1099;, &#1079;&#1072;&#1090;&#1077;&#1084; &#1086;&#1085;&#1072; &#1088;&#1072;&#1079;&#1086;&#1096;&#1083;&#1072;&#1089;&#1100; &#1087;&#1086; &#1074;&#1089;&#1077;&#1084;&#1091; &#1084;&#1080;&#1088;&#1091;, &#1074;&#1082;&#1083;&#1102;&#1095;&#1072;&#1103;, &#1088;&#1072;&#1079;&#1091;&#1084;&#1077;&#1077;&#1090;&#1089;&#1103;, &#1080; &#1085;&#1072;&#1089;. &#1048; &#1085;&#1080; &#1091; &#1082;&#1086;&#1075;&#1086;, &#1082;&#1088;&#1086;&#1084;&#1077; &#1043;&#1080;&#1090;&#1083;&#1077;&#1088;&#1072;, &#1080;&#1089;&#1087;&#1086;&#1083;&#1100;&#1079;&#1086;&#1074;&#1072;&#1085;&#1080;&#1077; &#1089;&#1074;&#1072;&#1089;&#1090;&#1080;&#1082;&#1080; &#1085;&#1077; &#1073;&#1099;&#1083;&#1086; &#1089;&#1080;&#1084;&#1074;&#1086;&#1083;&#1086;&#1084; &#1079;&#1083;&#1072;... &#1082;&#1072;&#1082; &#1089;&#1080;&#1084;&#1074;&#1086;&#1083; &#1079;&#1083;&#1072; &#1089;&#1091;&#1097;&#1077;&#1089;&#1090;&#1074;&#1086;&#1074;&#1072;&#1083;&#1072; &#1086;&#1073;&#1088;&#1072;&#1090;&#1085;&#1072;&#1103; "&#1089;&#1074;&#1072;&#1089;&#1090;&#1080;&#1082;&#1072; &#1051;&#1091;&#1085;&#1099;" &#1089; &#1083;&#1091;&#1095;&#1072;&#1084;&#1080; &#1074;&#1083;&#1077;&#1074;&#1086;, &#1072; &#1085;&#1077; &#1074;&#1087;&#1088;&#1072;&#1074;&#1086;. // &#1044;&#1072;, &#1077;&#1089;&#1090;&#1100; &#1080; &#1072;&#1083;&#1100;&#1090;&#1077;&#1088;&#1085;&#1072;&#1090;&#1080;&#1074;&#1085;&#1099;&#1077; &#1090;&#1077;&#1086;&#1088;&#1080;&#1080; &#1089;&#1074;&#1072;&#1089;&#1090;&#1080;&#1082;&#1080;. &#1059; &#1084;&#1077;&#1085;&#1103;, &#1087;&#1088;&#1072;&#1074;&#1076;&#1072;, &#1101;&#1090;&#1080; &#1072;&#1083;&#1100;&#1090;&#1077;&#1088;&#1085;&#1072;&#1090;&#1080;&#1074;&#1085;&#1099;&#1077; &#1089;&#1072;&#1081;&#1090;&#1099; &#1087;&#1086;&#1083;&#1085;&#1086;&#1089;&#1090;&#1100;&#1102; &#1085;&#1077; &#1086;&#1090;&#1082;&#1088;&#1099;&#1083;&#1080;&#1089;&#1100; &#1089;&#1077;&#1081;&#1095;&#1072;&#1089;, &#1095;&#1090;&#1086;-&#1090;&#1086; &#1086;&#1085;&#1080; &#1074;&#1089;&#1077; &#1088;&#1072;&#1079;&#1086;&#1084; &#1074;&#1080;&#1088;&#1091;&#1089;&#1072;&#1084;&#1080; &#1079;&#1072;&#1088;&#1072;&#1078;&#1077;&#1085;&#1099; ;-). &#1053;&#1077; &#1087;&#1088;&#1086;&#1087;&#1091;&#1089;&#1090;&#1080;&#1083;&#1072; &#1080;&#1093; &#1084;&#1086;&#1103; &#1054;&#1087;&#1077;&#1088;&#1072;, &#1088;&#1091;&#1075;&#1072;&#1077;&#1090;&#1089;&#1103;.&#160;(16:59:52 04.01.2012)
  
